# Copy this file to `.env` and fill in your real values.
# `.env` itself should NEVER be committed to git (it already is in .gitignore).

POSTGRES_USER=football_user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=football_predictor

# Optional: set this to fully override the connection string above
# (e.g. to point at SQLite for quick local testing instead of Postgres).
# DATABASE_URL=sqlite:///./local_dev.db

ECHO_SQL=false
